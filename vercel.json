{
  "outputDirectory": "public",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "{migrations/**,wos-app.json,package.json,tools.json}",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/((?!ui/|app/).*)", "destination": "/api/index?__p=/$1" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] }
  ]
}
