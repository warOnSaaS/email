# Copy to .env. Never commit .env.

# Required: two long random strings (for example: openssl rand -base64 48)
EMAIL_SECRET_KEY=     # encrypts mailbox passwords; kept outside the database
OAUTH_SECRET=         # signs sessions, reply tokens and signed links

# Where people reach the app (used in signed links and sign-in links)
PUBLIC_URL=http://localhost:3990

# The first owner, so you can sign in. More people are added in Settings.
TEAM_MEMBERS=Your Name <you@your-team.example> owner

# Sign in with GitHub (optional): a GitHub OAuth app with callback PUBLIC_URL/oauth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Mail the app sends itself (sign-in links). Optional once a command mailbox is connected.
SMTP_URL=             # e.g. smtps://user:pass@smtp.your-provider.example
MAIL_FROM=wOS <no-reply@your-team.example>

# AI sorting and drafts (optional): any OpenAI-compatible server
MODEL_BASE_URL=       # e.g. https://api.openai.com/v1 or http://host.docker.internal:11434/v1
MODEL_API_KEY=
MODEL_NAME=

# Hosted on a scheduler instead of a long-running server: a secret for /api/cron
CRON_SECRET=
