{
  "$schema": "https://raw.githubusercontent.com/warOnSaaS/suite/main/packages/manifest/wos-app.schema.json",
  "id": "email",
  "name": "Email",
  "description": "Fast, keyboard-first email with AI sorting and drafts, and the team address that runs wOS by email.",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "requires": { "core": ">=0.1" },
  "tools": "./tools.json",
  "tables": "./migrations",
  "server": "./server.mjs",
  "screens": "./dist/screens.mjs",
  "icon": "mail",
  "nav": { "label": "Email", "order": 40 },
  "events": {
    "emits": ["email.message.received", "email.message.sent", "email.command.received", "email.alert.answered"],
    "listens": []
  },
  "needs": {
    "services": [],
    "permissions": ["notifications"],
    "desktop": ["mailto"],
    "env": ["EMAIL_SECRET_KEY", "OAUTH_SECRET", "MODEL_BASE_URL", "MODEL_API_KEY", "MODEL_NAME", "SYNC_SECONDS", "POLL_SECONDS", "SYNC_INITIAL"]
  },
  "data": { "onDisable": "keep", "exports": ["accounts", "threads", "messages", "drafts", "settings", "members", "commands", "alerts"] }
}
